[Unit]
Description=Copias independientes de empresas habilitadas en AutosQP
After=network-online.target mysql.service autosqp.service

[Service]
Type=oneshot
User=autosqp
Group=www-data
WorkingDirectory=/home/autosqp/apps/autosqp/backend
ExecStart=/home/autosqp/apps/autosqp/backend/venv/bin/python /home/autosqp/apps/autosqp/ops/backup/company-backup-daily.py
Environment=AUTOSQP_COMPANY_BACKUP_ROOT=/var/lib/autosqp-company-backups
UMask=0077
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
PrivateTmp=true
NoNewPrivileges=true
TimeoutStartSec=6h

