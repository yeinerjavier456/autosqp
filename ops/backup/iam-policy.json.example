{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListAutosqpBackupPrefix",
      "Effect": "Allow",
      "Action": ["s3:ListBucket"],
      "Resource": "arn:aws:s3:::REEMPLAZAR-BUCKET",
      "Condition": {
        "StringLike": {"s3:prefix": ["autosqp-production/*"]}
      }
    },
    {
      "Sid": "ReadWriteAutosqpBackups",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject"],
      "Resource": "arn:aws:s3:::REEMPLAZAR-BUCKET/autosqp-production/*"
    }
  ]
}
